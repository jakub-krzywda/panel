# Skopiuj do /home/pi/panel/.env (poza repo) i ustaw prawa: chmod 600 .env
# Hasło do strony (HTTP Basic). Puste = bez logowania — nie zostawiaj pustego w sieci domowej.
DZIENNIK_USER=kuba
DZIENNIK_PASSWORD=
# Opcjonalnie (domyślne wartości w nawiasach):
# DZIENNIK_DB_URL=sqlite:////home/pi/panel/data/dziennik.sqlite   (data/dziennik.sqlite)
# DZIENNIK_SCREENSHOTS_DIR=/home/pi/panel/data/screenshots         (data/screenshots)
